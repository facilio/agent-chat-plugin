{
  "name": "agent-chat-plugin",
  "version": "0.3.1",
  "private": true,
  "description": "Claude Code channel plugin for Facilio Agent Chat",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/server.ts --bundle --platform=node --target=node18 --format=cjs --outfile=plugin/dist/server.cjs --external:bufferutil --external:utf-8-validate --legal-comments=none --minify",
    "test": "npm run build --silent && ts-node scripts/test-plugin.ts && ts-node scripts/test-pairing.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.25.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}

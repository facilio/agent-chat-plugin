{
  "name": "agent-chat-plugin",
  "version": "0.6.0",
  "private": true,
  "description": "Claude Code plugin (hooks module + bridge) for Facilio Agent Chat",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && esbuild src/bridge.ts --bundle --platform=node --target=node18 --format=cjs --outfile=plugin/dist/bridge.cjs --external:bufferutil --external:utf-8-validate --legal-comments=none --minify",
    "test": "npm run build --silent && ts-node scripts/test-bridge.ts",
    "validate": "claude plugin validate plugin"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.25.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
